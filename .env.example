# ImprintCV Configuration

# Default LLM Provider: gemini | openai | anthropic | openrouter
IMPRINTCV_PROVIDER=gemini

# Google Gemini (Free tier: 1,500 req/day)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Custom Career Vault location (defaults to ~/career/)
# IMPRINTCV_VAULT_PATH=/path/to/your/career
