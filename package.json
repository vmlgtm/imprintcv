{
  "name": "imprintcv",
  "version": "0.1.2",
  "description": "AI resume verification engine & ATS document compiler",
  "author": "Vaibhav Misra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmlgtm/imprintcv.git"
  },
  "bugs": {
    "url": "https://github.com/vmlgtm/imprintcv/issues"
  },
  "homepage": "https://github.com/vmlgtm/imprintcv#readme",
  "keywords": [
    "resume",
    "ats",
    "career",
    "mcp",
    "typst",
    "cli",
    "ai",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "imprintcv": "dist/cli.js",
    "imprintcv-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "doctor": "node dist/cli.js doctor",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.10",
    "@ai-sdk/google": "^1.1.18",
    "@ai-sdk/openai": "^1.1.14",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@openrouter/ai-sdk-provider": "^0.3.0",
    "ai": "^4.1.47",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-redact": "^3.5.0",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.9.0",
    "ora": "^8.2.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
